APP_NAME=Umrany
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=UTC
APP_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=umrany
DB_USERNAME=umrany
DB_PASSWORD=umrany
DB_SCHEMA=umrany

SESSION_DRIVER=redis
CACHE_STORE=redis
QUEUE_CONNECTION=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_SERIALIZER=igbinary

OCTANE_SERVER=roadrunner

BROADCAST_CONNECTION=reverb
REVERB_APP_ID=umrany
REVERB_APP_KEY=umrany-key
REVERB_APP_SECRET=umrany-secret
REVERB_HOST="0.0.0.0"
REVERB_PORT=8080
REVERB_SCHEME=http
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="localhost"
VITE_REVERB_PORT=80
VITE_REVERB_SCHEME=http

HORIZON_DOMAIN=null
HORIZON_PATH=horizon

MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_FROM_ADDRESS="no-reply@umrany.com"
MAIL_FROM_NAME="${APP_NAME}"

SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000

# Third-party integrations (see docs/architecture/tech-stack.md)
PAYMENT_GATEWAY_KEY=
PAYMENT_GATEWAY_SECRET=
GOOGLE_MAPS_API_KEY=
FCM_PROJECT_ID=
FCM_CREDENTIALS_PATH=
GOV_API_BASE_URL=
GOV_API_KEY=

AI_SERVICE_PROVIDER=
AI_SERVICE_API_KEY=
