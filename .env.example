APP_NAME=Umrany
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=UTC
APP_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=umrany
DB_USERNAME=umrany
DB_PASSWORD=umrany
DB_SCHEMA=umrany

SESSION_DRIVER=redis
CACHE_STORE=redis
QUEUE_CONNECTION=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_SERIALIZER=igbinary

OCTANE_SERVER=roadrunner

BROADCAST_CONNECTION=reverb
REVERB_APP_ID=umrany
REVERB_APP_KEY=umrany-key
REVERB_APP_SECRET=umrany-secret
REVERB_HOST="0.0.0.0"
REVERB_PORT=8080
REVERB_SCHEME=http
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="localhost"
VITE_REVERB_PORT=80
VITE_REVERB_SCHEME=http

HORIZON_DOMAIN=null
HORIZON_PATH=horizon

# Email is the delivery channel for account verification (when registered by email),
# password reset, and the password-changed security confirmation (always, regardless of which
# channel the reset code used) — see Modules/Core/app/Notifications/. Every credential below
# flows through config/mail.php's env() calls; nothing is ever hardcoded in application code.
# MAIL_HOST=mailhog/MAIL_PORT=1025 assumes a local Mailhog-type catch-all container, which this
# docker-compose.yml does not currently define (see docs/architecture/infrastructure.md) — for
# real delivery in any shared environment, replace MAIL_HOST/MAIL_PORT/MAIL_USERNAME/MAIL_PASSWORD
# with a real SMTP provider's credentials.
MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-reply@umrany.com"
MAIL_FROM_NAME="${APP_NAME}"

SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000
# Minutes until an issued Sanctum token expires (30 days) — see config/sanctum.php. Pruned from
# the personal_access_tokens table daily by the sanctum:prune-expired schedule in routes/console.php.
SANCTUM_EXPIRATION_MINUTES=43200

# Password policy — read by CoreServiceProvider::boot()'s Password::defaults(), the single rule
# every FormRequest that validates a password (User and Admin) shares. PASSWORD_HISTORY_COUNT=0
# disables reuse checking; see Modules/Core/app/Services/PasswordHistoryService.php.
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_MIXED_CASE=true
PASSWORD_REQUIRE_NUMBERS=true
PASSWORD_REQUIRE_SYMBOLS=false
PASSWORD_CHECK_COMPROMISED=false
PASSWORD_HISTORY_COUNT=5

# TOTP MFA (Modules/Core/app/Services/MfaService.php) — MFA_ISSUER falls back to APP_NAME.
MFA_ISSUER=
MFA_WINDOW=1
MFA_RECOVERY_CODE_COUNT=8
MFA_CHALLENGE_TTL=300
MFA_CHALLENGE_MAX_ATTEMPTS=5

# Avatar upload (Modules/Core/app/Services/ProfileService.php) — every upload is re-encoded to
# this format/size regardless of what was submitted.
AVATAR_MAX_KILOBYTES=2048
AVATAR_WIDTH=512
AVATAR_HEIGHT=512
AVATAR_FORMAT=webp
AVATAR_QUALITY=82

# "Suspicious login attempt" notification threshold (Modules/Core/app/Services/AuthService.php).
SUSPICIOUS_LOGIN_THRESHOLD=5
SUSPICIOUS_LOGIN_WINDOW_MINUTES=15

# Bootstrap Super Admin — seeded idempotently on every boot (Modules/Core/database/seeders/AdminSeeder).
# ADMIN_PASSWORD below is a local-only placeholder; it MUST be overridden for any shared environment.
ADMIN_NAME="Super Admin"
ADMIN_EMAIL=admin@umrany.com
ADMIN_PASSWORD=ChangeMe123!

# Third-party integrations (see docs/architecture/tech-stack.md)
PAYMENT_GATEWAY_KEY=
PAYMENT_GATEWAY_SECRET=
GOOGLE_MAPS_API_KEY=
FCM_PROJECT_ID=
FCM_CREDENTIALS_PATH=
GOV_API_BASE_URL=
GOV_API_KEY=

AI_SERVICE_PROVIDER=
AI_SERVICE_API_KEY=
