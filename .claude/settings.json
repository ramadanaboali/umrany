      "Bash(docker compose run --rm app composer*)",
      "Bash(docker compose run --rm --no-deps app composer*)",
      "Bash(docker compose run --rm app ./vendor/bin/pest*)",
      "Bash(docker compose run --rm app ./vendor/bin/pint*)",
      "Bash(docker compose run --rm app ./vendor/bin/phpstan*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)"
    ]
  }
